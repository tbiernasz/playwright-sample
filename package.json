{
  "name": "playwright-sample",
  "version": "1.0.0",
  "description": "Playwright + AI test automation sample with planner/generator/healer agents",
  "scripts": {
    "start:mock": "node app/server.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:headed:slow": "playwright test --headed --workers=1",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "report": "playwright show-report",
    "lint": "eslint tests/ --ext .ts",
    "format": "prettier --write tests/ playwright.config.ts",
    "format:check": "prettier --check tests/ playwright.config.ts"
  },
  "keywords": ["playwright", "testing", "e2e", "ai-agents"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0"
  }
}
